# Percorso del database SQLite (default: file:./data/intranet.db)
DATABASE_URL=file:./data/intranet.db

# UID/GID per docker-compose build (default 1000 = utente pi su Raspberry Pi)
APP_UID=1000
APP_GID=1000

# Suffissi host considerati rete locale (virgola). Default: .lan,.home.arpa,.local,.internal
LOCAL_SUFFIXES=.lan,.home.arpa,.local,.internal

# Range CIDR VPN trattati come rete locale (default Tailscale 100.64.0.0/10)
VPN_RANGES=100.64.0.0/10

# Mercusys (opzionale, solo sulla rete di casa — non committare valori reali)
# L'URL può essere impostato anche da Admin > Asset > Import; la password resta solo qui.
MERCUSYS_URL=
MERCUSYS_PASSWORD=
# MERCUSYS_MOCK=1  # solo sviluppo locale: non usare in produzione